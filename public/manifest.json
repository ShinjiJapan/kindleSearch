{
  "manifest_version": 3,
  "version": "2.0",
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "ja",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.amazon.co.jp/",
    "https://www.amazon.com/"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}